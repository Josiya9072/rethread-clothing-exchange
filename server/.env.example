DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use local sqlite for quick testing.
# For PostgreSQL, set these instead:
POSTGRES_DB=rethread
POSTGRES_USER=rethread
POSTGRES_PASSWORD=rethread
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
USE_POSTGRES=False

CORS_ALLOWED_ORIGINS=http://localhost:5173
